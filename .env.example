# ─────────────────────────────────────────────────────────────
# Sidicoin environment variables
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Values are intentionally left empty — no real credentials belong in git.
# ─────────────────────────────────────────────────────────────

# ── Core application (REQUIRED) ──
# The bot cannot start without these. See src/config/env.js.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_ID=
ADMIN_API_TOKEN=
ENCRYPTION_KEY=
BOT_WEBHOOK_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KORAPAY_SECRET_KEY=

# ── Optional integrations ──
# Missing values disable the matching feature; the core app still runs.
KORAPAY_PUBLIC_KEY=
TON_API_KEY=
GROQ_API_KEY=
# SIDI price in NGN. Leave empty to use the default of 5.
SIDI_PRICE_NGN=
SIDI_FEE_WALLET=
